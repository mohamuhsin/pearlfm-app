{
  "expo": {
    "name": "Pearl FM",
    "slug": "pearl-fm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pearlfm",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "updates": {
      "enabled": false
    },

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FE7C1C"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pearlfmuganda.com",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSMicrophoneUsageDescription": "This app uses the microphone for live radio features."
      }
    },

    "android": {
      "package": "pearlfmuganda.com",
      "versionCode": 2,

      "permissions": ["FOREGROUND_SERVICE", "POST_NOTIFICATIONS"],

      "foregroundService": {
        "notificationTitle": "Pearl FM Radio",
        "notificationBody": "Playing live stream…",
        "notificationColor": "#FE7C1C"
      },

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FE7C1C"
      },

      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "https", "host": "pearlfm.ug" },
            { "scheme": "pearlfm" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],

      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "extra": {
      "eas": {
        "projectId": "584e5f7f-cd91-452b-9df9-77e81dd0a020"
      }
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": ["expo-audio", "expo-system-ui"],

    "owner": "mohamuhsins-organization"
  }
}
